uint8_t ConnectToWifi(void){
  //give it 10seconds to connect
  //then 2 minutes of acces point time

  WiFi.mode(WIFI_STA);
  WiFi.begin();

  Serial.println("Trying to connect to saved Wi-Fi...");

  unsigned long startAttemptTime = millis();
  const unsigned long timeout = 10000; // 10 seconds

  while (WiFi.status() != WL_CONNECTED && millis() - startAttemptTime < timeout) {
    Serial.print(".");
    delay(500);
  }

    if (WiFi.status() == WL_CONNECTED) {
      Serial.println("\nConnected to Wi-Fi!");
      Serial.print("IP Address: ");
      Serial.println(WiFi.localIP());
      printEP("Breathing Block","WiFi", "connected","", ""); //OK
      delay(5000);
      return 1;
    }

    //disconnect before switching to wifimanager
    WiFi.disconnect();
    WiFi.mode(WIFI_OFF);

    wifiManager.setConnectTimeout(120); // set the connect timeout to 120 seconds
    wifiManager.setTimeout(120); // set the portal timeout to 120 seconds
    
    unsigned long startTime = millis();
      printEP(" Setup WiFi", "connect to", "'BB Connect'", "on phone", ""); //OK
      if (wifiManager.autoConnect("BB-Connect")) {
          delay(1000); 
          Serial.println("WiFi connected");
          printEP("Breathing Block","WiFi", "connected","", ""); //OK
          delay(5000);
      } else {
          Serial.println("AP TIMEOUT") ;
      }
    return 0;
}

int printLocalTime() {
  if (!getLocalTime(&timeinfo)) {
    Serial.println("Failed to obtain time");
    return 0;
  }
  Serial.println(&timeinfo, "%A, %B %d %Y %H:%M:%S");
  return 1;
}

void getNextDay(struct tm currentTime) {
  // Step 1: Convert to time_t (epoch time)
  time_t now = mktime(&currentTime);

  // Step 2: Add 24 hours (86400 seconds)
  time_t tomorrow = now + 86400;

  // Step 3: Convert back to struct tm
  localtime_r(&tomorrow, &nextDay);

  // Print result
  Serial.println(&nextDay, "Tomorrow is: %A, %B %d %Y %H:%M:%S");
}

int getwaterlevel(){
  int waterValue =0;
  Serial.print("Distance in mm: ");
  water_distance = lox.readRange();
  Serial.println(water_distance);
  if(water_distance > low_THRESHOLD)
    waterValue = WATER_IS_LOW;
  else if(water_distance > medium_THRESHOLD)
    waterValue =WATER_IS_MEDIUM;
  else waterValue =WATER_IS_HIGH;

  return waterValue;

  
}

  

